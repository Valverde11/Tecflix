# Plantilla para la raíz. NO contiene secretos reales ni se carga automáticamente.
# Generar cada secreto con: openssl rand -hex 32
AUTH_SECRET=
SERVICE_SECRET=
# Elegir rutas absolutas si las APIs se inician desde directorios distintos.
DATA_DIR=./data/users
TECFLIX_STORAGE=./data/videos
# MongoDB local: usar un URI de replica set SOLO después de configurarlo.
MONGO_URI=mongodb://127.0.0.1:27017/?serverSelectionTimeoutMS=3000
MONGO_DB=tecflix_metadata
