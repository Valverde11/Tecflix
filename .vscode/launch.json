{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Tecflix API",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tecflix-api",
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "TECFLIX_PORT", "value": "8083" },
                { "name": "TECFLIX_STORAGE", "value": "${workspaceFolder}/data" }
            ],
            "MIMode": "gdb"
        }
    ]
}