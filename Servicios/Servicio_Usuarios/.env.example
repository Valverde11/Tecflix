# Variables de entorno de user-service. El ejecutable no lee este archivo: hay que
# definirlas en el entorno del proceso. El .env real nunca se sube al repositorio.
PORT=8081
DATA_DIR=./data
CORS_ORIGIN=http://localhost:5173

# Obligatoria y compartida por todas las APIs: al menos 32 bytes aleatorios.
# Vacía a propósito para que el servicio no arranque con un secreto conocido.
AUTH_SECRET=

# Necesario para autenticar las operaciones internas de cuotas (no incluir en Git).
SERVICE_SECRET=

# V2: activar solo si el binario fue compilado con USER_SERVICE_ENABLE_POSTGRES=ON.
# TECFLIX_USER_STORAGE=postgres
# PGHOST=127.0.0.1
# PGPORT=55432
# PGUSER=tecflix
# PGDATABASE=tecflix_v2
# PGPASSWORD=
