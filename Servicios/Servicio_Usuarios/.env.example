# Variables de entorno de user-service. El ejecutable no lee este archivo: hay que
# definirlas en el entorno del proceso. El .env real nunca se sube al repositorio.
PORT=8081
DATA_DIR=./data
CORS_ORIGIN=http://localhost:5173

# Obligatoria y compartida por todas las APIs: al menos 32 bytes aleatorios.
# Vacía a propósito para que el servicio no arranque con un secreto conocido.
AUTH_SECRET=
